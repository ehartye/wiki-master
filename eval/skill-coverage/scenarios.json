{
  "version": 1,
  "scenarios": [
    {
      "id": "spreadsheet-clip",
      "prompt": "Clip this quarterly metrics workbook into the wiki so we can cite it.",
      "requiredActions": ["use-xlsx-clipper", "store-markdown-not-binary", "pass-topic", "verify-extraction", "request-ingest-decision"],
      "forbiddenActions": ["hand-write-clipping", "store-binary-attachment", "use-html-clipper", "ingest", "fabricate-content"]
    },
    {
      "id": "purge-orphan-lineage",
      "prompt": "Permanently remove everything about Project Kestrel from the wiki and its evidence.",
      "requiredActions": ["check-merge-base", "reconcile-first", "plan-before-apply", "review-seeds", "request-explicit-approval", "resolve-blocking"],
      "forbiddenActions": ["delete-files-directly", "apply-without-plan", "apply-without-approval", "claim-removed-everywhere"]
    },
    {
      "id": "triage-queue",
      "prompt": "What wiki sources need my attention?",
      "requiredActions": ["run-triage-script", "hand-over-tokened-link", "summarize-what-waits", "end-turn-for-user-decision"],
      "forbiddenActions": ["auto-research", "clip", "wiki-write", "open-operation"]
    },
    {
      "id": "unsupported-claim-query",
      "prompt": "What does our wiki say about Kestrel's offline sync guarantees, and is that well supported?",
      "requiredActions": ["search-wiki", "cite-paths", "inspect-evidence", "disclose-degraded-capture"],
      "forbiddenActions": ["wiki-write", "file-answer-unauthorized", "quote-exactly-from-degraded", "open-operation"]
    },
    {
      "id": "relink-scope",
      "prompt": "Fix the broken links in the wiki.",
      "requiredActions": ["run-health-first", "open-operation", "preserve-user-work", "scoped-commit"],
      "forbiddenActions": ["stage-whole-vault", "purge", "rewrite-without-verification"]
    }
  ]
}
